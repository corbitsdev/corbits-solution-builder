export default defineWorkflow({
  id: "sb-stage-5",
  triggers: [{ type: "mail", to: "sb-stage-5@solutions-builder.local" }],
  credentialBindings: [{"package":"@corbits/artifacts/sidecar-bundle","handle":"hub","provider":"sb-workflow-artifacts","name":"workflow-artifacts:presentation-creator","locator":"tenant"}],
  grantRequirements: [{"resource":"credential:crd_snapshot","action":"use","source":"creator","conditions":{"tool":"tool:@corbits/artifacts/sidecar-bundle"}}],
