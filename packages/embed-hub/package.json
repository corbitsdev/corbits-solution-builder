{
  "name": "@solutions-builder/embed-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Embeds an Interchange hub in-process: binds a pglite handle, composes createApp/createAuth, and places sidecars through the process provisioner.",
  "exports": {
    ".": "./src/index.ts",
    "./pg-compat": "./src/pg-compat.ts"
  },
  "dependencies": {
    "@corbits/artifacts": "github:corbitsdev/corbits-artifacts",
    "@corbits/codex-provider": "github:corbitsdev/corbits-codex-provider",
    "@corbits/mailbox": "github:corbitsdev/corbits-mailbox",
    "@corbits/oauth-core": "github:corbitsdev/corbits-oauth-core",
    "@corbits/process-provisioner": "workspace:*",
    "@corbits/xai-provider": "github:corbitsdev/corbits-xai-provider",
    "@electric-sql/pglite": "^0.3.16",
    "@intx/authz": "workspace:*",
    "@intx/crypto": "workspace:*",
    "@intx/db": "workspace:*",
    "@intx/hub-api": "workspace:*",
    "@intx/hub-sessions": "workspace:*",
    "@intx/types": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  }
}
