{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solutions Builder",
  "version": "0.1.0",
  "identifier": "com.corbits.solutions-builder",
  "build": {
    "beforeBuildCommand": "cd ../.. && bun run ui:build && bun run sidecar:build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/solutions-builder-host"
    ],
    "resources": {
      "../web/dist/": "dist/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Turns a half-formed problem into shipped software",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
