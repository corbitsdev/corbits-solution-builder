    "@intx/hub-common": "0.4.0",
    "@intx/hub-sessions": "workspace:*",
    "@intx/inference": "0.4.0",
    "@intx/inference-catalog": "0.4.0",
    "@intx/log": "0.4.0",
    "@intx/mail-memory": "0.4.0",
    "@intx/mailbox": "0.4.0",
    "@intx/mime": "0.4.0",
