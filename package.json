  },
  "devDependencies": {
    "@corbits/embedded-host": "workspace:*",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssri": "catalog:",
    "@vitejs/plugin-react": "^5.0.4",
    "postgres": "3.4.9",
    "ssri": "catalog:",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "vendor/interchange/packages/*",
    "vendor/interchange/apps/*",
    "vendor/workbench/packages/*"
  ],
  "overrides": {
    "@intx/hub-common": "0.4.0",
    "@intx/db": "workspace:*",
    "@intx/hub-api": "workspace:*",
    "@intx/hub-client": "workspace:*",
    "@intx/hub-sessions": "workspace:*",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "@intx/workflow-host": "workspace:*"
  },
  "catalog": {
    "@types/semver": "^7.7.1",
    "@types/ssri": "^7.1.5",
    "arktype": "^2.1.29",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.9",
    "isomorphic-git": "^1.27.2",
