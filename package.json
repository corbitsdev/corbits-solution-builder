    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "@intx/workflow-deploy": "0.4.0",
    "@intx/workflow-host": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@solutions-builder/app": "workspace:*",
    "@corbits/embed-hub": "workspace:*",
    "@solutions-builder/installer": "workspace:*",
    "@corbits/keychain": "workspace:*",
    "@solutions-builder/tools-deck": "workspace:*",
    "@solutions-builder/tools-delivery": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2.8.0",
    "arktype": "^2.1.29",
    "better-auth": "^1.4.18",
