{
  "name": "solutions-builder",
  "version": "0.1.0",
  "private": true,
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/solutions-builder-alpha.git"
  },
  "description": "Solutions Builder \u2014 turns a half-formed problem into shipped software through nine human-gated stages.",
  "type": "module",
  "scripts": {
    "dev": "bun run vendor:build && bun scripts/dev.ts",
    "dev:desktop": "bun scripts/dev.ts --desktop",
    "dev:fresh": "bun scripts/dev.ts --desktop --fresh",
    "dev:stop": "bun scripts/stop-dev.ts",
    "host": "bun apps/hub/src/server.ts",
    "ui:build": "bun run assets:pack-closure && bun run assets:pack-project-workflow && vite build -c apps/web/vite.config.ts",
    "ui:watch": "bun run assets:pack-closure && bun run assets:pack-project-workflow && vite build -c apps/web/vite.config.ts --watch",
    "desktop:build": "bun scripts/desktop-release.ts",
    "desktop:build:dry": "bun scripts/desktop-release.ts --dry-run",
    "sidecar:build": "bun run vendor:build && bun scripts/build-sidecar.ts",
    "typecheck": "tsc --noEmit",
    "check:static": "bun run typecheck && bun run test",
    "check": "bun run check:static && bun run check:build",
    "walk": "bun run ui:build && bun scripts/walk-ui.tsx",
    "walk:browser": "bun run ui:build && scripts/walk-browser.sh",
    "vendor:build": "bun scripts/vendor-build.ts",
    "assets:pack-registry": "bun scripts/pack-registry-asset.ts",
    "assets:pack-closure": "bun scripts/pack-closure-static.ts",
    "assets:pack-project-workflow": "bun scripts/project-workflow-pack.ts",
    "adopt:legacy-projects": "bun scripts/adopt-legacy-projects.ts",
    "postinstall": "bun run vendor:build",
    "test": "bun test apps/hub/src packages/embed-hub/src packages/embedded-host/src packages/installer/src packages/keychain/src packages/solutions-builder/src packages/tools-delivery/src apps/web/src scripts/desktop-launch-mode.test.ts scripts/interface-build.test.ts scripts/stop-dev.test.ts scripts/closure-pack.test.ts scripts/lib/tarball.test.ts",
    "check:build": "bun run ui:build"
  },
  "dependencies": {
    "@corbits/artifacts": "github:corbitsdev/corbits-artifacts#031fc9e",
    "@standard-schema/spec": "^1.0.0",
    "@corbits/codex-provider": "github:corbitsdev/corbits-codex-provider",
    "@corbits/mailbox": "github:corbitsdev/corbits-mailbox",
    "@corbits/oauth-core": "github:corbitsdev/corbits-oauth-core",
    "@corbits/openai-responses": "github:corbitsdev/corbits-openai-responses",
    "@corbits/process-provisioner": "workspace:*",
