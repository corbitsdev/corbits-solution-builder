{
  "name": "solutions-builder",
  "version": "0.1.0",
  "private": true,
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/solutions-builder-alpha.git"
  },
  "description": "Solutions Builder \u2014 turns a half-formed problem into shipped software through nine human-gated stages.",
  "type": "module",
  "scripts": {
    "dev": "bun run vendor:build && bun scripts/dev.ts",
    "dev:desktop": "bun scripts/dev.ts --desktop",
    "dev:fresh": "bun scripts/dev.ts --desktop --fresh",
    "host": "bun --conditions intx-src apps/hub/src/server.ts",
    "ui:build": "vite build -c apps/web/vite.config.ts",
    "ui:watch": "vite build -c apps/web/vite.config.ts --watch",
    "desktop:build": "bun scripts/desktop-release.ts",
    "desktop:build:dry": "bun scripts/desktop-release.ts --dry-run",
    "sidecar:build": "bun run vendor:build && bun scripts/build-sidecar.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "check:static": "bun run check:shards && bun run check:vendored-migrations && bun run check:ledger && bun run check:boundaries && bun scripts/embed-workflow-closure.ts --check && bun run typecheck && bun run test && bun run test:vendored",
    "check:core": "bun run smoke && bun run smoke:upgrade && bun run smoke:db-lock",
    "check:launch": "bun run ui:build && bun run smoke:launch",
    "check:product": "bun run smoke:conversation && bun run smoke:catalog && bun run smoke:choices && bun run smoke:transfer && bun run smoke:material && bun run smoke:stakeholders && bun run smoke:deck",
    "check:deploy": "bun run smoke:sidecar",
    "check:behaviour": "bun run smoke:guidance && bun run smoke:kit && bun run smoke:failure && bun run smoke:design && bun run smoke:oauth && bun run smoke:hub",
    "check": "bun run check:static && bun run check:core && bun run check:launch && bun run check:ui && bun run check:product && bun run check:behaviour && bun run check:deploy",
    "check:shards": "bun scripts/check-shards.ts",
    "check:ledger": "bun --conditions intx-src scripts/check-ledger.ts",
    "check:boundaries": "bun --conditions intx-src scripts/check-boundaries.ts",
    "smoke": "bun --conditions intx-src scripts/loop-smoke.ts",
    "smoke:design": "bun --conditions intx-src scripts/design-smoke.ts",
    "smoke:oauth": "bun --conditions intx-src scripts/oauth-smoke.ts",
    "smoke:agent": "bun --conditions intx-src scripts/agent-smoke.ts",
    "seed": "bun run vendor:build && bun --conditions intx-src scripts/seed.ts",
    "seed:demo": "bun --conditions intx-src scripts/seed-demo.ts",
    "seed:workspace": "bun --conditions intx-src scripts/seed-workspace.ts",
    "smoke:hub": "bun --conditions intx-src scripts/hub-topology-smoke.ts",
    "check:slop": "bun scripts/check-slop.ts",
    "smoke:upgrade": "bun --conditions intx-src scripts/upgrade-smoke.ts",
    "smoke:launch": "bun scripts/launch-smoke.ts",
    "smoke:db-lock": "bun --conditions intx-src scripts/db-lock-smoke.ts",
    "check:layout": "bun scripts/layout-stability-smoke.ts",
    "smoke:responsive": "bun scripts/responsive-smoke.ts",
    "smoke:failure": "bun --conditions intx-src scripts/failure-smoke.ts",
    "check:markdown": "bun --conditions intx-src scripts/check-markdown.ts",
    "smoke:conversation": "bun --conditions intx-src scripts/conversation-smoke.ts",
    "smoke:guidance": "bun --conditions intx-src scripts/guidance-smoke.ts",
    "walk": "bun run ui:build && bun --conditions intx-src scripts/walk-ui.tsx",
    "check:tokens": "bun scripts/check-tokens.ts",
    "smoke:kit": "bun --conditions intx-src scripts/kit-smoke.ts",
    "smoke:catalog": "bun --conditions intx-src scripts/catalog-smoke.ts",
    "check:ui": "bun run check:slop && bun run check:tokens && bun run check:layout && bun run check:markdown",
    "check:full": "bun run check && bun run smoke:responsive",
    "smoke:sidecar": "bun run vendor:build && bun --conditions intx-src scripts/sidecar-smoke.ts",
    "smoke:choices": "bun scripts/choices-smoke.ts",
    "smoke:transfer": "bun --conditions intx-src scripts/transfer-smoke.ts",
    "smoke:material": "bun --conditions intx-src scripts/material-smoke.ts",
    "smoke:stakeholders": "bun --conditions intx-src scripts/stakeholders-smoke.ts",
    "smoke:deck": "bun --conditions intx-src scripts/deck-smoke.ts",
    "vendor:build": "bun scripts/vendor-build.ts",
    "assets:pack-registry": "bun --conditions intx-src scripts/pack-registry-asset.ts",
    "postinstall": "bun run vendor:build",
    "check:vendored-migrations": "bun --conditions intx-src scripts/check-vendored-migrations.ts",
    "test": "bun test apps/hub/src packages/installer/src packages/tools-delivery/src apps/web/src",
    "test:vendored": "bun test vendor/interchange/packages/hub-api/src/routes/tenants.test.ts vendor/interchange/packages/hub-api/src/routes/sessions.test.ts vendor/interchange/packages/hub-api/src/routes/assets.test.ts vendor/interchange/packages/hub-api/src/routes/workflow-definitions.test.ts vendor/interchange/packages/hub-api/src/routes/workflows.test.ts"
  },
  "dependencies": {
    "@corbits/artifacts": "github:corbitsdev/corbits-artifacts",
    "@corbits/codex-provider": "github:corbitsdev/corbits-codex-provider",
    "@corbits/oauth-core": "github:corbitsdev/corbits-oauth-core",
    "@corbits/openai-responses": "github:corbitsdev/corbits-openai-responses",
    "@corbits/process-provisioner": "workspace:*",
    "@corbits/react-ui": "github:corbitsdev/react-ui",
    "@corbits/xai-provider": "github:corbitsdev/corbits-xai-provider",
    "@electric-sql/pglite": "^0.3.16",
    "@intx/agent": "workspace:*",
    "@intx/authz": "workspace:*",
    "@intx/crypto": "workspace:*",
    "@intx/db": "workspace:*",
    "@intx/hub-api": "workspace:*",
    "@intx/hub-client": "workspace:*",
    "@intx/hub-common": "workspace:*",
    "@intx/hub-sessions": "workspace:*",
    "@intx/inference": "workspace:*",
    "@intx/inference-catalog": "workspace:*",
    "@intx/log": "workspace:*",
    "@intx/mail-memory": "workspace:*",
    "@intx/mailbox": "workspace:*",
    "@intx/mime": "workspace:*",
    "@intx/sidecar-app": "workspace:*",
    "@intx/storage-isogit": "workspace:*",
    "@intx/tool-packaging": "workspace:*",
    "@intx/tools-posix": "workspace:*",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "@intx/workflow-deploy": "workspace:*",
    "@intx/workflow-host": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@solutions-builder/app": "workspace:*",
    "@solutions-builder/installer": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2.8.0",
    "arktype": "^2.1.29",
    "better-auth": "^1.4.18",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.12.32",
    "jszip": "3",
    "lucide-react": "^1.43.0",
    "pptxgenjs": "4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-joyride": "^3.2.0",
    "sonner": "^2.0.8",
    "unpdf": "^1.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "postgres": "3.4.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "vendor/interchange/packages/*",
    "vendor/interchange/apps/*",
    "vendor/workbench/packages/*"
  ],
  "catalog": {
    "@types/semver": "^7.7.1",
    "@types/ssri": "^7.1.5",
    "arktype": "^2.1.29",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.9",
    "isomorphic-git": "^1.27.2",
    "postgres": "^3.4.8",
    "semver": "^7.7.2",
    "ssri": "^12.0.0",
    "tar": "^7.5.1"
  },
  "trustedDependencies": [
    "@corbits/react-ui"
  ]
}
